# ==========================================
# GGY Finance - Fastify REST API Dockerfile
# Multi-stage production build (Node 20 Alpine)
# ==========================================

# Stage 1: Build
FROM node:20-alpine AS builder
WORKDIR /app

# Copy root workspace manifests
COPY package.json package-lock.json* ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/api/package.json ./apps/api/

# Install dependencies across monorepo
RUN npm ci

# Copy source code
COPY packages/shared ./packages/shared
COPY apps/api ./apps/api

# Build shared package then api
RUN npm run build --workspace=@nbfc/shared
RUN npm run build --workspace=@nbfc/api

# Stage 2: Production Runner
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=4000
ENV HOST=0.0.0.0

# Create non-root user for security
RUN addgroup -S nbfcgroup && adduser -S nbfcuser -G nbfcgroup

# Copy built artifacts and runtime node_modules
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/packages/shared/package.json ./packages/shared/package.json
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/drizzle ./apps/api/drizzle
COPY --from=builder /app/apps/api/package.json ./apps/api/package.json

# Create vault storage directory with correct permissions
RUN mkdir -p /app/vault_storage && chown -R nbfcuser:nbfcgroup /app

USER nbfcuser

EXPOSE 4000

CMD ["node", "apps/api/dist/server.js"]
