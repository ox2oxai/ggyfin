apiVersion: v1
kind: Secret
metadata:
  name: ggy-secrets
  namespace: ggy-finance
type: Opaque
stringData:
  # 1. PostgreSQL 16 Database URL (Native or Supabase AWS Mumbai ap-south-1)
  DATABASE_URL: "postgresql://ggy_admin:SECURE_PASSWORD@postgres.internal:5432/ggy_finance?sslmode=require"

  # 2. Staff Authentication JWT Secret (min 32 characters)
  JWT_SECRET: "REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_JWT_SECRET_32_CHARS"

  # 3. AES-256-GCM Envelope Encryption Key (exactly 64 hex characters = 32 bytes)
  KYC_MASTER_KEY: "REPLACE_WITH_64_HEX_CHARACTERS_MASTER_KEY_FOR_AES_256_GCM"

  # 4. AWS Mumbai / Cloudflare R2 Credentials
  AWS_ACCESS_KEY_ID: "REPLACE_WITH_AWS_ACCESS_KEY"
  AWS_SECRET_ACCESS_KEY: "REPLACE_WITH_AWS_SECRET_KEY"

  # 5. Indian Telecom & Messaging Integrations
  SMS_GATEWAY_KEY: "REPLACE_WITH_TRAI_DLT_SMS_GATEWAY_API_KEY"
  WHATSAPP_PHONE_NUMBER_ID: "REPLACE_WITH_META_WHATSAPP_PHONE_ID"
  WHATSAPP_ACCESS_TOKEN: "REPLACE_WITH_META_WHATSAPP_PERMANENT_ACCESS_TOKEN"
