# ==========================================
# GGY Finance - Next.js Presentation Web Dockerfile
# Multi-stage production build (Node 20 Alpine)
# ==========================================

# Stage 1: Build
FROM node:20-alpine AS builder
WORKDIR /app

# Copy root workspace manifests
COPY package.json package-lock.json* ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/web/package.json ./apps/web/

# Install dependencies across monorepo
RUN npm ci

# Copy source code
COPY packages/shared ./packages/shared
COPY apps/web ./apps/web

# Build shared package then web Next.js application
RUN npm run build --workspace=@nbfc/shared
RUN npm run build --workspace=@nbfc/web

# Stage 2: Production Runner
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Non-root user for security
RUN addgroup -S nextgroup && adduser -S nextuser -G nextgroup

# Copy built Next.js static output and standalone artifacts
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/packages/shared/package.json ./packages/shared/package.json
COPY --from=builder /app/apps/web/public ./apps/web/public
COPY --from=builder /app/apps/web/.next ./apps/web/.next
COPY --from=builder /app/apps/web/package.json ./apps/web/package.json

RUN chown -R nextuser:nextgroup /app

USER nextuser

EXPOSE 3000

CMD ["npm", "run", "start", "--workspace=@nbfc/web"]
