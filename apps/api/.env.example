# ==============================================================================
# DATABASE CONNECTION PROVISION (PostgreSQL 16 / Supabase Ready)
# ==============================================================================
# 1. Local PostgreSQL (Active Default):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nbfc_db

# 2. Supabase Provision (When ready to host on cloud - AWS Mumbai ap-south-1):
# Direct Connection (Port 5432 - for migrations):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
# Pooled Connection (Port 6543 - for high concurrency serverless/app traffic):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
# Set DB_SSL=true if required by cloud provider
# DB_SSL=true

# HTTP Server Port
PORT=4000
HOST=0.0.0.0

# JWT Secret for Staff Authentication (Replace in production)
JWT_SECRET=super_secret_jwt_key_for_nbfc_banking_staff_auth_min_32_chars_long

# Master Key for KYC Envelope Encryption (32-byte / 64 hex characters)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KYC_MASTER_KEY=c39121a8eb83794d0e527d7f7e914bb491a61c3f2d2b51614e56994ec81358a9

# UPI Merchant Config (NPCI Universal Dynamic QR)
UPI_MERCHANT_VPA=ggycollect@icici
UPI_PAYEE_NAME=GGY Finance

# Pluggable Storage Driver: 'local' (default) or 's3' (AWS S3 / Cloudflare R2 / Supabase Storage)
STORAGE_DRIVER=local
# S3_BUCKET_NAME=ggy-finance-kyc-vault
# S3_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://ggy-finance-kyc-vault.s3.ap-south-1.amazonaws.com

# TRAI DLT SMS Gateway Config (Indian Telecom Compliant)
# DLT_ENTITY_ID=1101234567890123456
# DLT_HEADER=GGYFIN
# SMS_GATEWAY_API_KEY=

# Meta WhatsApp Business Cloud API (Graph API v21.0)
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
